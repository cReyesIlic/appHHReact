# Backend
SECRET_OPENAIKEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_PLANNER_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_INDEX_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_ANSWER_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview
DATABASE_DIR=storage
MASTER_PATH=

# Microsoft Graph / SharePoint
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SITE_URL_OFERTAS=
SITE_URL_PROYECTOS=
SITE_NAME=
SHAREPOINT_SITE=

# Autenticación (Azure Static Web Apps / App Service Easy Auth)
AUTH_REQUIRED=true
AUTH_ALLOW_LOCAL_DEV=false
AUTH_ALLOWED_EMAIL_DOMAINS=shimin.cl
AUTH_ADMIN_EMAILS=cristian.reyes@shimin.cl

# Azure Blob opcional (solo si Master Excel está en blob)
AZURE_CONNECTION_STRING=
CONTAINER_NAME=
BLOB_NAME=
MASTER_PATH_BLOB=
CONNECTION_TO_PDF=

# RAG / LiteParse / Wiki
LITEPARSE_FUNCTION_URL=
RAG_ENDPOINT=
RAG_API_KEY=
WIKI_ENDPOINT=
WIKI_API_KEY=

# Azure Function: budget extractor (extracción robusta de HH/tarifas/gastos desde Excels)
# URL del Function App + API key del header x-api-key
BUDGET_EXTRACTOR_URL=https://apphh-budget-extractor.azurewebsites.net
BUDGET_EXTRACTOR_API_KEY=

# HH licitadas (path local o blob://container/prefix)
HH_EXCEL_SOURCE=storage/emitted_offer_assets/excel
HH_EXCEL_CACHE_DIR=storage/hh_excel_ingestion

# Email reports (Azure Communication Services)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=
EMAIL_REPORT_RECIPIENTS=

# Scheduler (sync periódico) — opcional, defaults razonables
# SYNC_SCHEDULE_ENABLED=true
# SYNC_SCHEDULE_HOUR=2
# SYNC_SCHEDULE_MINUTE=15
# SYNC_SCHEDULE_EVERY_DAYS=2
# SYNC_SCHEDULE_HOURS=2
# SYNC_SCHEDULE_LIMIT=20
# SYNC_SCHEDULE_TZ=America/Santiago

# Storage monitor (job diario que alerta si el File Share supera umbral)
# AZURE_STORAGE_ACCOUNT=apphhdrive
# AZURE_FILE_SHARE_NAME=shimin-data
# AZURE_STORAGE_KEY=         # o usar AZURE_CONNECTION_STRING arriba
# SHARE_USAGE_THRESHOLD=0.70
