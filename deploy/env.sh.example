# Renombrar a env.sh y completar. NO commitear env.sh (ya está en .gitignore).
# Después: source deploy/env.sh

export SUBSCRIPTION_ID=""             # az account show --query id -o tsv
export RG="rg-apphh"                  # Resource Group real
export REGION="chilecentral"

# Recursos existentes
export ACR_NAME="apphshimin"
export STORAGE_ACCOUNT="apphhdrive"
export APP_SERVICE="apphhshimin"
export APP_PLAN="ASP-appshimin"
export AOAI_NAME="testapphhopenai"
export DOCINTEL_NAME="docIntelhhSHIMIN"

# Nuevos (recomendado)
export SHARE_NAME="shimin-data"
export STATIC_WEB_APP="shimin-frontend"
export STATIC_WEB_REGION="eastus2"    # Static Web App no está en Chile Central

# Image tag para esta release
export IMAGE_TAG="v1"

# Tenant SHIMIN para auth (Entra ID)
export TENANT_ID=""                   # az account show --query tenantId -o tsv
export AAD_CLIENT_ID=""               # Crear App Registration en Entra ID

